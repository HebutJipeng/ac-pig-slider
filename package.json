{
  "name": "ac-pig-slider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node server/dev.mjs",
    "start": "node server/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node scripts/build-site.mjs && node --test tests/*.test.mjs",
    "check": "node --check src/main.js && node --check server/api.mjs && node --check server/dev.mjs",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  }
}
