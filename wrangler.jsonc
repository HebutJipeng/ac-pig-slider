{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ac-pig-slider-api",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,https://ac-pig-slider-pengji.magicgait2.chatgpt.site" },
  "d1_databases": [{ "binding": "DB", "database_name": "ac-pig-slider", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["59 15 * * *"] }
}
